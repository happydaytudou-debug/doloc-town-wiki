---
interface Source { id: string; name: string; title: string; url: string; type: string; intendedUse: string; checked: Date; verificationStatus: 'Verified' | 'Discovery Only'; claimNote?: string }
interface Props { sources: Source[] }
const { sources } = Astro.props;
const verified = sources.filter(({ verificationStatus }) => verificationStatus === 'Verified');
const discovery = sources.filter(({ verificationStatus }) => verificationStatus !== 'Verified');
---
{verified.length > 0 && <section class="source-section" aria-labelledby="reference-sources-title"><h2 id="reference-sources-title">Reference Sources</h2><ol>{verified.map((source) => <li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><span>{source.type} · reviewed {source.checked.toISOString().slice(0, 10)}</span>{source.claimNote && <p>{source.claimNote}</p>}</li>)}</ol></section>}
{discovery.length > 0 && <section class="source-section needs-source-review" aria-labelledby="research-links-title"><h2 id="research-links-title">Additional Research Links</h2><p>These broader references are provided for version context and further reading. They do not support specific gameplay conclusions on this page.</p><ol>{discovery.map((source) => <li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><span>{source.type} · reviewed {source.checked.toISOString().slice(0, 10)}</span></li>)}</ol></section>}
