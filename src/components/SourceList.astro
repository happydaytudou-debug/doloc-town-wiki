---
interface Source { id: string; name: string; title: string; url: string; type: string; intendedUse: string; checked: Date; verificationStatus: 'Verified' | 'Discovery Only'; claimNote?: string }
interface Props { sources: Source[] }
const { sources } = Astro.props;
const verified = sources.filter(({ verificationStatus }) => verificationStatus === 'Verified');
const discovery = sources.filter(({ verificationStatus }) => verificationStatus !== 'Verified');
---
<section class="source-section" aria-labelledby="verified-sources-title"><h2 id="verified-sources-title">Verified Sources</h2>{verified.length ? <ol>{verified.map((source) => <li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><span>{source.type} · checked {source.checked.toISOString().slice(0, 10)}</span><p>{source.claimNote}</p></li>)}</ol> : <p>No claim-level source has been verified for this page yet. Specific gameplay conclusions remain unpublished.</p>}</section>
<section class="source-section needs-source-review" aria-labelledby="verification-sources-title"><h2 id="verification-sources-title">Sources for Verification</h2><p>These supplied links are discovery inputs. Their presence does not verify a specific gameplay claim.</p><ol>{discovery.map((source) => <li id={`source-${source.id}`}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a><span>{source.type} · supplied check date {source.checked.toISOString().slice(0, 10)}</span><p><strong>Intended use:</strong> {source.intendedUse}</p>{source.claimNote && <p>{source.claimNote}</p>}</li>)}</ol></section>
